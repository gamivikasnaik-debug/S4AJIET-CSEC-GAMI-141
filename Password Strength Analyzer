import hashlib
import math
import os
import re
import secrets
import string
import urllib.request
from typing import Dict, List, Tuple


class PasswordStrengthAnalyzer:
    COMMON_BLACKLIST = {
        "password", "123456", "12345678", "qwerty", "admin", "welcome",
        "iloveyou", "password123", "letmein", "monkey", "dragon"
    }

    SEQUENCES = [
        "0123456789", "9876543210",
        "abcdefghijklmnopqrstuvwxyz",
        "qwertyuiop", "asdfghjkl", "zxcvbnm"
    ]

    def __init__(self, use_pwned_api: bool = False):
        self.use_pwned_api = use_pwned_api

    def calculate_pool_entropy(self, password: str) -> float:
        """Calculates theoretical entropy in bits based on character pool size."""
        pool_size = 0
        if re.search(r"[a-z]", password):
            pool_size += 26
        if re.search(r"[A-Z]", password):
            pool_size += 26
        if re.search(r"[0-9]", password):
            pool_size += 10
        if re.search(r"[^a-zA-Z0-9]", password):
            pool_size += 33  # Standard ASCII punctuation

        if pool_size == 0 or len(password) == 0:
            return 0.0

        return len(password) * math.log2(pool_size)

    def _check_sequences(self, password: str) -> List[str]:
        issues = []
        lowered = password.lower()
        for seq in self.SEQUENCES:
            for i in range(len(seq) - 2):
                chunk = seq[i : i + 3]
                if chunk in lowered:
                    issues.append(f"Sequential run detected: '{chunk}'")
                    break
        return issues

    def check_hibp_breach(self, password: str) -> int:
        """K-anonymity check via Have I Been Pwned API."""
        sha1_hash = hashlib.sha1(password.encode("utf-8")).hexdigest().upper()
        prefix, suffix = sha1_hash[:5], sha1_hash[5:]

        url = f"https://api.pwnedpasswords.com/range/{prefix}"
        req = urllib.request.Request(url, headers={"User-Agent": "Password-Analyzer"})

        try:
            with urllib.request.urlopen(req, timeout=3) as response:
                hashes = response.read().decode("utf-8").splitlines()
                for line in hashes:
                    h_suffix, count = line.split(":")
                    if h_suffix == suffix:
                        return int(count)
        except Exception:
            return -1  # API unreachable or offline
        return 0

    def evaluate(self, password: str) -> Dict:
        issues = []
        recommendations = []

        # 1. Length check
        length = len(password)
        if length < 8:
            issues.append("Critically short (under 8 characters).")
        elif length < 12:
            issues.append("Length is minimal; 14+ characters recommended.")

        # 2. Character diversity
        has_lower = bool(re.search(r"[a-z]", password))
        has_upper = bool(re.search(r"[A-Z]", password))
        has_digit = bool(re.search(r"[0-9]", password))
        has_symbol = bool(re.search(r"[^a-zA-Z0-9]", password))

        if not has_lower:
            recommendations.append("Include lowercase letters.")
        if not has_upper:
            recommendations.append("Include uppercase letters.")
        if not has_digit:
            recommendations.append("Include numbers.")
        if not has_symbol:
            recommendations.append("Include special characters (e.g., !@#$%).")

        # 3. Predictable patterns
        if password.lower() in self.COMMON_BLACKLIST:
            issues.append("Matches a globally common, easily guessable password.")

        seq_issues = self._check_sequences(password)
        issues.extend(seq_issues)

        # Repeated characters (e.g., 'aaa')
        if re.search(r"(.)\1{2,}", password):
            issues.append("Contains repeated identical characters (3+ times in a row).")

        # 4. Breach verification
        breached_count = 0
        if self.use_pwned_api and length > 0:
            breached_count = self.check_hibp_breach(password)
            if breached_count > 0:
                issues.append(f"Found in known data breaches ({breached_count:,} times).")

        # 5. Entropy calculation
        entropy = self.calculate_pool_entropy(password)

        # 6. Overall strength rating
        if issues and ("Critically short" in issues[0] or breached_count > 0 or len(issues) >= 3):
            rating = "Very Weak"
        elif entropy < 45 or len(issues) >= 2:
            rating = "Weak"
        elif entropy < 65 or len(recommendations) >= 2:
            rating = "Moderate"
        elif entropy < 80:
            rating = "Strong"
        else:
            rating = "Very Strong"

        return {
            "password": "*" * len(password),
            "length": length,
            "entropy_bits": round(entropy, 2),
            "strength": rating,
            "issues": issues,
            "recommendations": recommendations,
        }

    @staticmethod
    def generate_alternative(length: int = 16, passphrase: bool = False) -> str:
        """Generates a secure replacement using cryptographically secure PRNG."""
        if passphrase:
            # 4-word Diceware style passphrase
            word_list = ["correct", "horse", "battery", "staple", "galaxy", "timber", "shield", "beacon", "vector"]
            chosen = [secrets.choice(word_list).capitalize() for _ in range(4)]
            return "-".join(chosen) + str(secrets.randbelow(90) + 10)

        chars = string.ascii_letters + string.digits + "!@#$%^&*"
        while True:
            candidate = "".join(secrets.choice(chars) for _ in range(length))
            # Ensure candidate hits all classes
            if (any(c.islower() for c in candidate) and
                any(c.isupper() for c in candidate) and
                any(c.isdigit() for c in candidate) and
                any(c in "!@#$%^&*" for c in candidate)):
                return candidate

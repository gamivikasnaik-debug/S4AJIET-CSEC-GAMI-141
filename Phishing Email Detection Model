import re
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score, ConfusionMatrixDisplay
import matplotlib.pyplot as plt

# -------------------------------------------------------------
# 1. Custom Transformer: Extract Structural & Heuristic Features
# -------------------------------------------------------------
class EmailFeatureExtractor(BaseEstimator, TransformerMixin):
    """
    Extracts numerical metadata from raw email text:
    - URL count and presence of raw IP addresses in links
    - Presence of urgency/security trigger keywords
    - Punctuation cues (exclamations, uppercase ratio)
    """
    def __init__(self):
        self.url_pattern = re.compile(r'https?://\S+|www\.\S+')
        self.ip_pattern = re.compile(r'https?://(?:\d{1,3}\.){3}\d{1,3}')
        self.urgency_keywords = ['urgent', 'suspend', 'verify', 'update', 'password', 'bank', 'login', 'security', 'alert']

    def fit(self, X, y=None):
        return self

    def transform(self, X):
        features = []
        for text in X:
            text_str = str(text).lower()
            raw_text = str(text)
            
            # Feature extraction
            url_count = len(self.url_pattern.findall(raw_text))
            has_ip_url = int(bool(self.ip_pattern.search(raw_text)))
            keyword_hits = sum(1 for kw in self.urgency_keywords if kw in text_str)
            exclamation_count = raw_text.count('!')
            uppercase_ratio = sum(1 for c in raw_text if c.isupper()) / (len(raw_text) + 1e-5)
            text_length = len(raw_text)

            features.append([
                url_count,
                has_ip_url,
                keyword_hits,
                exclamation_count,
                uppercase_ratio,
                text_length
            ])
        return np.array(features)

# -------------------------------------------------------------
# 2. Sample Dataset Creation (Replace with your actual CSV data)
# -------------------------------------------------------------
# Labels: 1 = Phishing, 0 = Safe
raw_data = {
    'email_text': [
        "Dear customer, your bank account has been suspended. Click http://192.168.1.1/login to verify your password immediately!",
        "Hey team, here are the updated meeting notes from today's sprint review. Let me know if you have questions.",
        "URGENT: Suspicious activity detected on your PayPal account. Update details at http://paypal-secure-verify.com/login",
        "Can we reschedule our sync to tomorrow at 3 PM? Let me know what works for you.",
        "Your Netflix subscription has expired. Click here to update your credit card details: http://netflix-billing-update.com",
        "Attached is the project invoice for services rendered in September. Thanks for your business.",
        "Security Alert! Your mailbox storage is full. Verify now at http://mail-verify-admin.net or access will be blocked.",
        "Reminder: The company all-hands meeting starts in 15 minutes in room 4B."
    ],
    'label': [1, 0, 1, 0, 1, 0, 1, 0]
}

# Expand toy data to demonstrate training and split
df = pd.DataFrame(raw_data)
df = pd.concat([df] * 15, ignore_index=True)  # Replicate rows for runnable demo split

X = df['email_text']
y = df['label']

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

# -------------------------------------------------------------
# 3. Model Pipeline Construction
# -------------------------------------------------------------
# Combine TF-IDF text features and numerical structural features
feature_processor = ColumnTransformer(
    transformers=[
        ('tfidf', TfidfVectorizer(ngram_range=(1, 2), max_features=1000, stop_words='english'), 0),
        ('heuristics', EmailFeatureExtractor(), 0)
    ]
)

pipeline = Pipeline([
    ('features', feature_processor),
    ('classifier', RandomForestClassifier(n_estimators=100, random_state=42))
])

# -------------------------------------------------------------
# 4. Training and Evaluation
# -------------------------------------------------------------
pipeline.fit(X_train, y_train)
y_pred = pipeline.predict(X_test)

# Metrics
acc = accuracy_score(y_test, y_pred)
target_names = ['Safe', 'Phishing']

print(f"Model Accuracy: {acc * 100:.2f}%\n")
print("Classification Report:")
print(classification_report(y_test, y_pred, target_names=target_names))

# Confusion Matrix
cm = confusion_matrix(y_test, y_pred)
print("Confusion Matrix:")
print(cm)

disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=target_names)
disp.plot(cmap='Blues')
plt.title("Phishing Detection - Confusion Matrix")
plt.show()

# -------------------------------------------------------------
# 5. Live Inference Function
# -------------------------------------------------------------
def predict_email(text: str) -> str:
    prediction = pipeline.predict([text])[0]
    prob = pipeline.predict_proba([text])[0][prediction]
    label = "Phishing" if prediction == 1 else "Safe"
    return f"Prediction: {label} (Confidence: {prob * 100:.1f}%)"

# Quick check
sample_email = "Action required: Your account password will expire today. Verify here: http://secure-update-bank.com"
print(predict_email(sample_email))
